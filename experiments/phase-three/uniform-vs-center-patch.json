{
  "format": "melakat-experiment-spec-0.1",
  "name": "phase-three-uniform-vs-center-patch",
  "description": "First Phase Three matched causal experiment. Total initial resource and per-tick energy input are identical between conditions; only the spatial allocation pattern differs between uniform control and a deterministic central resource patch. Organism sensing/movement remains disabled so this experiment isolates environmental heterogeneity itself.",
  "base_config": {
    "run.engine_backend": "phase-three-vm",
    "run.max_ticks": 2000,
    "world.width": 96,
    "world.height": 70,
    "world.spatial_enabled": true,
    "world.boundary_model": "reflective",
    "world.offspring_dispersion_radius": 1.4,
    "world.neighborhood_radius": 2.0,
    "world.initial_energy": 1000.0,
    "world.energy_input_per_tick": 20.0,
    "world.local_resources_enabled": true,
    "world.resource_grid_cols": 10,
    "world.resource_grid_rows": 7,
    "world.local_capture_limit": 1.0,
    "world.organism_actions_enabled": false,
    "world.resource_distribution_mode": "uniform",
    "world.resource_patch_fraction": 0.30,
    "world.resource_patch_contrast": 4.0,
    "population.initial_size": 12,
    "population.initial_energy": 25.0,
    "population.memory_per_organism": 8,
    "world.memory_capacity": 500,
    "execution.instructions_per_tick": 8,
    "execution.instruction_cost": 0.05,
    "execution.maintenance_cost": 0.2,
    "reproduction.enabled": true,
    "reproduction.cost": 12.0,
    "reproduction.offspring_energy": 8.0,
    "mutation.substitution_rate": 0.01
  },
  "seeds": {
    "start": 1,
    "count": 30
  },
  "conditions": [
    {
      "name": "uniform-control",
      "overrides": {
        "world.resource_distribution_mode": "uniform"
      }
    },
    {
      "name": "center-patch",
      "overrides": {
        "world.resource_distribution_mode": "center_patch"
      }
    }
  ],
  "reproducibility": {
    "condition": "uniform-control",
    "seed": 1
  }
}
